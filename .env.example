# ---- Général ----
PORT=3000
PUBLIC_URL=https://votre-domaine.com        # URL publique (callbacks pawaPay)
DATA_DIR=./data                              # dossier de la base SQLite (à mettre sur un disque persistant)
TOKEN_SECRET=CHANGEZ_MOI_UNE_LONGUE_CHAINE_ALEATOIRE_DE_48_CARACTERES_MINIMUM
ALLOWED_ORIGINS=                             # ex: https://localhost,capacitor://localhost (appli mobile) — vide = même origine

# ---- Admin (numéro qui aura accès au tableau de bord des revenus) ----
ADMIN_PHONE=060000000

# ---- Tarifs (FCFA) ----
BOOST_PRICE=1500
BOOST_DAYS=7
CERTIFICATION_PRICE=30000
WITHDRAWAL_FEE_RATE=0.03
MIN_WITHDRAWAL=500

# ---- Paiements ----
PAYMENT_PROVIDER=mock                        # mock (tests) | pawapay (production)
PAWAPAY_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io   # production : https://api.pawapay.io

# ---- E-mail (code de réinitialisation du mot de passe) ----
EMAIL_PROVIDER=mock                          # mock (tests, n'envoie rien) | brevo (production, vrai e-mail)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=                          # une adresse vérifiée dans votre compte Brevo (Paramètres -> Expéditeurs)
BREVO_SENDER_NAME=Grand Marché

# ---- Base de données persistante (Turso — https://turso.tech, gratuit, sans carte) ----
# Si ces deux variables sont vides, le serveur utilise un fichier local (effacé si l'hébergeur redémarre).
# Si elles sont renseignées, les données sont stockées sur Turso et survivent aux redémarrages.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
